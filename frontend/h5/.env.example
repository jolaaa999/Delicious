# 本地开发：Vite 代理到 localhost:8080，无需设置
# VITE_API_BASE_URL=/api/v1

# 生产（可选）：直连后端，需后端配置 CORS
# VITE_API_BASE_URL=https://your-api-gateway.example.com/api/v1

# Vercel 部署：在 Vercel 控制台设置 BACKEND_URL（Serverless 代理用）
# BACKEND_URL=https://your-api-gateway.example.com

# 图片相对路径解析（与后端 PUBLIC_BASE_URL 一致）
# VITE_API_ORIGIN=https://your-api-gateway.example.com

# 图片上传需直连后端（Vercel 代理不支持 multipart），与 BACKEND_URL 相同
